---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { formatDate, noteUrl, ofType } from '../../lib/content';
const books = await ofType('reading');
// The shelf repeats the list below, so it only appears once there are enough books to fill it.
const showShelf = books.length >= 6;
---
<Base title="Reading">
  <main class="wrap">
    <div class="page-head"><h1>The shelf</h1><p class="lede">Books I've read, and the notes I kept.</p></div>
    {showShelf && <Shelf books={books} />}
    <div class={showShelf ? 'year' : undefined}>
      {books.map((b) => (
        <a class="entry" href={noteUrl(b)}>
          <span class="mono">{formatDate(b.data.date)}</span>
          <div><strong>{b.data.title}</strong><p>{b.data.author}{b.data.rating != null && ` · ${b.data.rating} / 5`}</p></div>
        </a>
      ))}
    </div>
  </main>
</Base>
