---
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { backlinks, formatDate, noteUrl, ofType, readingTime, tagSlug, tagUrl } from '../lib/content';
const { note } = Astro.props;
const { Content, headings } = await render(note);
const links = await backlinks(note);
const d = note.data;
const hasImage = fs.existsSync(path.resolve('public/og', `${note.id}.png`));
const image = hasImage ? `/og/${encodeURIComponent(note.id)}.png` : undefined;
const label = d.type[0].toUpperCase() + d.type.slice(1);

// A contents list only earns its place on longer notes.
const toc = headings.filter((h) => h.depth === 2);
// The drop cap suits an essay, not a two-line thought.
const dropcap = d.type === 'writing' && (note.body ?? '').length > 600;
const tags = d.tags.filter((tag) => tagSlug(tag));

// Older and newer notes in the same section. Lists are newest first.
const section = d.type === 'writing' || d.type === 'reflection' ? ['writing', 'reflection'] : [d.type];
const siblings = await ofType(...section);
const here = siblings.findIndex((n) => n.id === note.id);
const newer = here > 0 ? siblings[here - 1] : undefined;
const older = here >= 0 ? siblings[here + 1] : undefined;
---
<Base title={d.title} description={d.summary} image={image} ogType="article">
  <main class="wrap">
    <div class="narrow">
      <div class="page-head">
        <p class="mono kicker">{label} / {formatDate(d.date)} / {readingTime(note.body)} min</p>
        <h1>{d.title}</h1>
        {d.author && <p class="bookrow">{d.author}{d.rating != null && ` · ${d.rating} / 5`}</p>}
        {d.place && <p class="bookrow">{d.place}</p>}
      </div>
      {toc.length >= 3 && (
        <nav class="toc" aria-labelledby="toc-title">
          <p id="toc-title" class="mono">In this note</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class:list={['prose', { dropcap }]}><Content /></article>
      {tags.length > 0 && (
        <p class="tags">{tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}</p>
      )}
      {(older || newer) && (
        <nav class="pager" aria-label="More notes">
          {older ? <a href={noteUrl(older)} rel="prev"><span class="mono">Older</span><strong>{older.data.title}</strong></a> : <span></span>}
          {newer ? <a class="next" href={noteUrl(newer)} rel="next"><span class="mono">Newer</span><strong>{newer.data.title}</strong></a> : <span></span>}
        </nav>
      )}
      {links.length > 0 && (
        <section class="linked" aria-labelledby="linked">
          <h2 id="linked">Connected eyes</h2>
          <div class="card-grid">
            {links.map((n) => <a href={noteUrl(n)}><span class="mono">{n.data.type}</span><strong>{n.data.title}</strong></a>)}
          </div>
        </section>
      )}
    </div>
  </main>
</Base>
