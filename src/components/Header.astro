---
import Logo from './Logo.astro';
import site from '../../site.config.mjs';
const { dark = false, logoId = 'logo' } = Astro.props;
const here = Astro.url.pathname;
// Weekly is private, so it lives in the footer rather than the main menu.
const items = [['Writing', '/writing/'], ['Reading', '/reading/'], ['Travel', '/travel/'], ['About', '/about/']];
---
<header class="site-head">
  <a class="brand" href="/"><Logo dark={dark} id={logoId} />{site.title}</a>
  <div class="head-right">
    <nav class="site-nav" aria-label="Main">
      {items.map(([label, href]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between light and dark mode">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><path fill="currentColor" d="M12 3a9 9 0 0 1 0 18Z"></path></svg>
    </button>
  </div>
</header>
